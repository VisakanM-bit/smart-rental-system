# SQLite is used locally. Replace with a managed PostgreSQL URL for deployment.
DATABASE_URL=sqlite:///data/rental_intelligence.db
APP_SECRET_KEY=change-this-in-production
ALERT_TEMPERATURE_C=105
ALERT_IDLE_HOURS=5
ALERT_FUEL_DROP_PERCENT=20
# Local tamper-evident ledger. Use "fabric-anchor" only after deploying the
# adapter and a permissioned Fabric network; never store raw telemetry on-chain.
LEDGER_MODE=hash-chain
# Optional production-only Hyperledger Fabric gateway. The gateway is responsible
# for membership, mTLS, endorsement, and private-data collection policy.
FABRIC_GATEWAY_URL=
FABRIC_API_TOKEN=
